# Copy to .env.test.local (gitignored) for `npm run test:live`. Never commit real keys.
# In CI, CUSTOM_LLM_KEY comes from the repository secret of the same name.

# Custom OpenAI-compatible endpoint used by the live LLM tests
CUSTOM_LLM_KEY=
CUSTOM_LLM_BASE_URL=https://ollama.com/v1
CUSTOM_LLM_MODEL=gemma4:31b

# Optional accounts: copy to .env.local (gitignored) and set in Vercel to enable sign-in.
# Only the anon/publishable key belongs here — never the service_role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
