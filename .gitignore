# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code: share agents, skills and commands; keep worktrees and local settings out
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/

# debug
tests/fixtures/camera/private/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tesseract worker and cores, copied from node_modules by scripts/copy-tesseract.mjs
/public/tesseract/
