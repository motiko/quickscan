# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.jks
*.keystore

# Claude Code: share agents, skills and commands; keep worktrees and local settings out
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/

# debug
tests/fixtures/camera/private/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tesseract worker and cores, copied from node_modules by scripts/copy-tesseract.mjs
/public/tesseract/

# Scanner benchmark: large or private media stays out of git (see docs/scanner-data-plan.md)
tests/output/
tests/fixtures/camera/*.MOV
/bench/corpus/remote/
/bench/corpus/frames/private/
/bench/train/
/bench/pages/*.pdf
/bench/pages/*.png

# MIDV-500 samples: the specimen cards carry a portrait, so the frames are fetched locally (npm run bench:fetch -- --sample midv), never committed
/bench/corpus/frames/midv/*.jpg
/bench/corpus/previews/midv/*.png
/bench/corpus/overlays/

# Synthetic cases are regenerated from the seed by npm run bench:synth
/bench/corpus/frames/synth/
/bench/corpus/previews/synth/

# Static export for the native app: server-only files parked by scripts/build-export.mjs
/.export-stash/
/bench/corpus/ocr-crops/
# tesseract.js caches language data in the working directory when the bench runs in Node
/*.traineddata
