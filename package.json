{
  "name": "quickscan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-tesseract.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:supabase": "vitest run --config vitest.supabase.config.mts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "sim": "./scripts/ios-simulator.sh",
    "bench:pages": "node bench/tools/pages.mjs",
    "bench:synth": "node bench/tools/synth.mjs",
    "bench:validate": "node bench/tools/validate-manifest.mjs",
    "bench:fetch": "node bench/tools/fetch-corpus.mjs",
    "build:export": "node scripts/copy-tesseract.mjs && node scripts/build-export.mjs",
    "cap:sync": "npm run build:export && cap sync",
    "ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@supabase/supabase-js": "2.117.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "canvas": "^3.2.3",
    "capacitor-native-ocr": "0.2.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "franc-min": "^6.2.0",
    "jsqr": "1.4.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scanic": "^1.6.0",
    "tesseract.js": "7.0.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
